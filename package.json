{
  "name": "better-newsletter-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm --filter better-newsletter build && pnpm --filter @better-newsletter/cli build",
    "prepack": "pnpm build",
    "typecheck": "pnpm --filter better-newsletter typecheck && pnpm --filter better-newsletter build && pnpm --filter @better-newsletter/cli typecheck && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm migration:snapshot:check && pnpm test",
    "migration:snapshot:check": "node scripts/check-postgres-migration.mjs",
    "migration:snapshot:write": "pnpm --filter better-newsletter build && node scripts/check-postgres-migration.mjs --write",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:notes": "node scripts/release-notes.mjs --write"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@clack/prompts": "~1.0.1",
    "@eslint/js": "^9.35.0",
    "@nuxt/kit": "^4.6.0",
    "@release-it/bumper": "~8.0.1",
    "@types/pg": "^8.23.1",
    "better-newsletter": "workspace:*",
    "changelogen": "^0.6.2",
    "eslint": "^9.35.0",
    "h3": "^1.15.11",
    "kysely": "^0.28.17",
    "nuxt": "^4.6.0",
    "pg": "^8.23.0",
    "picocolors": "^1.1.1",
    "publint": "^0.3.24",
    "release-it": "~21.1.0",
    "resend": "^6.30.0",
    "semver": "^7.8.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.0"
  },
  "pnpm": {
    "overrides": {
      "better-newsletter-basic-example>better-newsletter": "workspace:*"
    }
  }
}
