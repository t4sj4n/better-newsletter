{
  "name": "better-newsletter-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm --filter better-newsletter build && pnpm --filter @better-newsletter/cli build",
    "prepack": "pnpm build",
    "typecheck": "pnpm --filter better-newsletter typecheck && pnpm --filter @better-newsletter/cli typecheck && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm migration:snapshot:check && pnpm test",
    "migration:snapshot:check": "node scripts/check-postgres-migration.mjs",
    "migration:snapshot:write": "pnpm --filter better-newsletter build && node scripts/check-postgres-migration.mjs --write"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.35.0",
    "@nuxt/kit": "^4.5.2",
    "@types/pg": "^8.23.1",
    "better-newsletter": "workspace:*",
    "eslint": "^9.35.0",
    "h3": "^1.15.11",
    "kysely": "^0.28.17",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "publint": "^0.3.24",
    "resend": "^6.30.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
