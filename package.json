{
  "name": "better-newsletter",
  "version": "0.0.0",
  "description": "Framework-agnostic newsletter subscription and consent lifecycle infrastructure for TypeScript.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t4sj4n/better-newsletter.git"
  },
  "engines": {
    "node": ">=20.11"
  },
  "packageManager": "pnpm@10.17.1",
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "import": "./dist/memory.js"
    },
    "./resend": {
      "types": "./dist/resend.d.ts",
      "import": "./dist/resend.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "import": "./dist/postgres.js"
    },
    "./nuxt": {
      "types": "./dist/nuxt.d.ts",
      "import": "./dist/nuxt.js"
    },
    "./nuxt/server": {
      "types": "./dist/nuxt/server.d.ts",
      "import": "./dist/nuxt/server.js"
    },
    "./nuxt/client": {
      "types": "./dist/nuxt/client.d.ts",
      "import": "./dist/nuxt/client.js"
    },
    "./package.json": "./package.json",
    "./security": {
      "types": "./dist/security.d.ts",
      "import": "./dist/security.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@nuxt/kit": "^4.5.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.35.0",
    "h3": "^1.15.11",
    "kysely": "^0.28.17",
    "nuxt": "^4.5.2",
    "pg": "^8.23.0",
    "publint": "^0.3.24",
    "resend": "^6.30.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  },
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "@nuxt/kit": "^4.5.2",
    "h3": "^1.15.11",
    "kysely": "^0.28.17",
    "nuxt": "^4.5.2",
    "resend": "^6.30.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "kysely": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "resend": {
      "optional": true
    }
  }
}
