# Default: process-local memory storage. Set to "postgres" for durable database state.
DEMO_STORAGE=memory

# Required only when DEMO_STORAGE=postgres.
DATABASE_URL=

# Default: fake local mailer. Set to "resend" for real delivery.
DEMO_MAILER=fake

# Trusted origin used in confirmation links.
DEMO_APP_ORIGIN=http://localhost:3000

# Required only when DEMO_MAILER=resend.
RESEND_API_KEY=
DEMO_RESEND_FROM="Better Newsletter <newsletter@example.com>"
